      "Value": "#{OP365_PURCHASE_REQUEST_THRESHOLD}#"
    },
    {
      "SchemaName": "op365_PurchasingApprover",
      "Value": "#{OP365_PURCHASING_APPROVER}#"
    },
    {
      "SchemaName": "op365_SharePointSiteUrl",
      "Value": "#{OP365_SHAREPOINT_SITE_URL}#"
    },
    {
      "SchemaName": "op365_ProjectLibraryId",
      "Value": "#{OP365_PROJECT_LIBRARY_ID}#"
    },
    {
      "SchemaName": "op365_PurchaseOrderLibraryId",
      "Value": "#{OP365_PURCHASE_ORDER_LIBRARY_ID}#"
    },
    {
      "SchemaName": "op365_SupplierDocumentLibraryId",
      "Value": "#{OP365_SUPPLIER_DOCUMENT_LIBRARY_ID}#"
