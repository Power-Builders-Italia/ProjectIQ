{
  "name": "projectiq-portfolio-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <23.0.0 || >=24.0.0 <25.0.0 || >=26.0.0 <27.0.0"
  },
  "scripts": {
    "sync:shared": "node scripts/sync-shared.mjs",
    "check:agent": "node scripts/validate-agent.mjs",
    "knowledge": "node scripts/knowledge.mjs",
    "test": "npm run sync:shared && heft test --clean",
    "build": "npm run sync:shared && npm run knowledge && npm run check:agent && heft test --clean --production && heft package-solution --production",
    "clean": "heft clean",
    "start": "npm run sync:shared && heft start --clean --nobrowser"
  },
  "dependencies": {
    "@fluentui/react-components": "9.74.9",
    "@fluentui/react-icons": "2.0.343",
    "@microsoft/sp-component-base": "1.24.0",
    "@microsoft/sp-copilot-component": "1.24.0",
    "@microsoft/sp-http": "1.24.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tslib": "2.3.1",
    "zod": "3.24.1",
    "zod-to-json-schema": "3.24.1"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.24.0",
    "@microsoft/eslint-plugin-spfx": "1.24.0",
    "@microsoft/spfx-heft-plugins": "1.24.0",
    "@microsoft/spfx-web-build-rig": "1.24.0",
    "@rushstack/heft": "1.3.2",
    "@types/jest": "30.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/webpack-env": "~1.15.2",
    "css-loader": "~7.1.2",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "typescript": "~5.8.0"
  },
  "overrides": {
    "@rushstack/heft": "1.3.2",
    "qs": ">=6.15.2",
    "uuid": ">=11.1.1"
  }
}
